{
  "name": "openlearn-plugin-lab-seat",
  "version": "0.6.3",
  "private": true,
  "type": "module",
  "description": "机房座位管理 - 教师编排布局分配座位，学生查看座位并签到",
  "author": "aymwoo",
  "scripts": {
    "build": "openlearn-plugin-sdk build",
    "build:test-bundle": "node test/build-test-bundle.mjs",
    "clean": "rm -rf dist tmp",
    "test": "node test/build-test-bundle.mjs && node --test test/csv.test.mjs test/smart-assign.test.mjs test/plugin.test.mjs",
    "test:csv": "node --test test/csv.test.mjs",
    "test:smart": "node --test test/smart-assign.test.mjs",
    "test:plugin": "node test/build-test-bundle.mjs && node --test test/plugin.test.mjs",
    "e2e:build": "node test/e2e/build.mjs",
    "e2e": "node test/e2e/build.mjs && node test/e2e/run.mjs",
    "test:watch": "node --test --watch test/csv.test.mjs test/smart-assign.test.mjs"
  },
  "dependencies": {
    "@openlearn/plugin-sdk": "^3.5.2"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "better-sqlite3": "^13.0.3",
    "esbuild": "^0.24.0",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "pino": "^10.3.1",
    "react": ">=17",
    "react-dom": ">=17",
    "semver": "^7.8.5",
    "typescript": "^5.0.0",
    "uuid": "^14.0.1"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ]
}
